# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# JWT secret key for authentication
JWT_SECRET=your_jwt_secret_here

# Resend email service API key
RESEND_API_KEY=your_resend_api_key_here

# Default "from" email address for Resend
RESEND_FROM_EMAIL=your_email@example.com

# Default "from" name for Resend
RESEND_FROM_NAME=My Business

# Base URL for frontend to call backend APIs
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

